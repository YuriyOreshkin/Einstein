@model  dynamic
@{
    ViewBag.Title = "еБилет";
}
@*<script src="https://securepay.tinkoff.ru/html/payForm/js/tinkoff_v2.js"></script>*@

<div class="k-form-container" style="margin-top: 10px; margin-left: auto; margin-right: auto; max-width: 600px;">
    <div class="content-wrapper" style="width: 600px; font-family: DejaVu Sans;padding: 0 10px;">
        @Html.Raw(Model.GetType().GetProperty("body").GetValue(Model, null))

    </div>

    <span id="order-id" style="display:none">@Model.GetType().GetProperty("orderid").GetValue(Model, null)</span>
    @if (Model.GetType().GetProperty("topay").GetValue(Model, null) != null && Model.GetType().GetProperty("topay").GetValue(Model, null) > 0)
    {
        @(Html.Kendo().Button().Name("pay-order").Tag("div").HtmlAttributes(new { type = "button", @class = "k-primary" }).Icon("cart").Content("Оплатить заказ "+@Model.GetType().GetProperty("topay").GetValue(Model, null).ToString("C")))
    }
    @(Html.Kendo().Button().Name("export-pdf").Tag("div").HtmlAttributes(new { type = "button" }).Icon("pdf").Content("Скачать билет"))

</div>

    <script>
    $(document).ready(function () {
        // NOTE: Only required if the Kendo UI stylesheets are loaded
        // from a different origin, e.g. kendo.cdn.telerik.com
        kendo.pdf.defineFont({
            "DejaVu Sans": "@Url.Content("~/Content/kendo/2019.3.1023/fonts/DejaVu/DejaVuSans.ttf")",
            "DejaVu Sans|Bold": "@Url.Content("~/Content/kendo/2019.3.1023/fonts/DejaVu/DejaVuSans-Bold.ttf")",
            "DejaVu Sans|Bold|Italic": "@Url.Content("~/Content/kendo/2019.3.1023/fonts/DejaVu/DejaVuSans-Oblique.ttf")",
            "DejaVu Sans|Italic": "@Url.Content("~/Content/kendo/2019.3.1023/fonts/DejaVu/DejaVuSans-Oblique.ttf")"
        });
        $("#export-pdf").click(function () {
            // Convert the DOM element to a drawing using kendo.drawing.drawDOM
            kendo.drawing.drawDOM($(".content-wrapper"))
                .then(function (group) {
                    // Render the result as a PDF file
                    return kendo.drawing.exportPDF(group, {
                        paperSize: "A4",
                        margin: { left: "0.1cm", top: "1cm", right: "0.3cm", bottom: "1cm" }
                    });
                })
                .done(function (data) {
                    // Save the PDF file
                    kendo.saveAs({
                        dataURI: data,
                        fileName: "TeslaTicket.pdf",
                        proxyURL: "@Url.Action("Pdf_Export_Save", "OrdersService")"
                    });
                });
        });

        $("#pay-order").click(function () {
            var orderid = $('#order-id').text();
            $.ajax({
                type: "POST",
                url: "@Url.Action("PayTicket", "OrderService") ",
                datatype: 'json',
                data: {orderid: orderid},
                success: function (data) {
                    if (data.Errors) {
                        ShowMessage(data);
                    }
                    else {
                        try {
                            pay(data);
                        }
                        catch (err) {
                            showError(err);
                        }
                    }
                    },
                error: function (xhr, ajaxOptions, thrownError) {

                    showError(xhr.status + " " + thrownError);
                    }
            });
        });
    });


    </script>

