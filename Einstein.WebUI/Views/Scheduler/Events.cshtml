
@{
    ViewBag.Title = "Расписание";
}
@Scripts.Render("~/Scripts/gridview.js")
@*<h2>Календарь мероприятий</h2>*@

<div id="events-content">

    <div id="filter-searcher" class="filter-section">

        <span class="k-textbox k-space-left" style="width: 100%;">
            @(Html.Kendo().DropDownList()
                                                    .Name("filterEventNames")
                                                    .OptionLabel("Любое мероприятие...")
                                                    .HtmlAttributes(new { style = "width: 100%;" })
                                                    //.Events(events=>events.Open("onFilterEventNamesOpen"))
                                                    .DataTextField("Title")
                                                    .DataValueField("Title")
                                                    .Height(300)
                                                    .AutoBind(false)
                                                    .TemplateId("eventDDLTemplate")
                                                    .DataSource(source => source.Read(read => read.Action("DropDownListReadNames", "SchedulerService")))
                                                    .Events(ev => ev.Change("schedulerFiltering"))
            )
            <span class="k-icon k-i-search"></span>
        </span>
        <span class="k-textbox k-space-left" style="width: 100%;">
            @(Html.Kendo().DropDownList()
                                                    .Name("filterPersons")
                                                    .OptionLabel(new  SelectListItem { Value="0", Text = "Любое кол-во мест..." })
                                                    .HtmlAttributes(new { style = "width: 100%;" })
                                                    //.Events(events=>events.Open("onFilterEventNamesOpen"))
                                                    .DataTextField("Text")
                                                    .DataValueField("Value")
                                                    .BindTo(new List<SelectListItem>() {
                                                        new SelectListItem
                                                        {
                                                            Text="1 — 5",
                                                            Value="1—"
                                                        },
                                                        new SelectListItem
                                                        {
                                                            Text="5 — 10",
                                                            Value="5—"
                                                        },
                                                        new SelectListItem
                                                        {
                                                            Text="10 — 15",
                                                            Value="10—"
                                                        },
                                                        new SelectListItem
                                                        {
                                                            Text="больше 15",
                                                            Value="15—"
                                                        }
                                                    })
                                                    .Events(ev => ev.Change("schedulerFiltering"))
            )
            <span class="k-icon k-i-user"></span>
        </span>
    </div>

    @(Html.Kendo().Scheduler<Einstein.WebUI.Models.EventViewModel>()
                                        .Name("scheduler")
                                        .MajorTimeHeaderTemplate("#=kendo.toString(date, 'HH:mm')#")
                                        .Max(DateTime.Now.AddMonths(3).AddDays(-7))
                                        .Views(views =>
                                        {
                                            views.AgendaView();

                                        })
                                        .Editable(false)
                                        .EventTemplateId("eventCardsTemplate")
                                        .Timezone("W-SU")
                                        .Mobile(MobileMode.Auto)
                                        .Height(650)
                                        .DataSource(d => d
                                            .Model(m =>
                                            {
                                                m.Id(f => f.TaskID);

                                            })
                                            .Read("Read", "SchedulerService")
                                            .Events(events => {
                                                events.Error("error_handler");
                                            })
                                        )

    )

</div>

<script id="eventDDLTemplate" type="text/x-kendo-template">

    <div class="k-card-header">
                   <h5 class="k-card-title" >#= Title#</h5>
                   <h6 class="k-card-subtitle">ближайшее #= kendo.toString(kendo.parseDate(Dates[0].Times[0].Start), 'dd.MM.yyyy с HH:mm' )# до #= kendo.toString(kendo.parseDate(Dates[0].Times[0].End), 'HH:mm' )#</h6>
        </div>
</script>

<script id="eventCardsTemplate" type="text/x-kendo-template">
     <div class="k-card k-card-horizontal">
        <div class="k-card-media" style="background-color: #= Color #;width:30px;"></div>
       <div class="k-vbox k-column" style="width:100%">
         <div class="k-card-header">
                    <h5 class="k-card-title" >#= title#</h5>
                    <h6 class="k-card-subtitle">#= kendo.toString(start, 'dd.MM.yyyy dddd HH:mm' )# — #= kendo.toString(end, 'HH:mm' )#</h6>
         </div>
        #if(description){#
            <div class="k-card-body">
                <p>#= kendo.toString(description) #</p>
            </div>
        #}#

        <div class="k-card-footer">
                        <div class="footer-item"><span class="event-info-item event-price"><span>Цена: </span><strong>#=kendo.toString(kendo.parseInt(Price), "c0")#</strong></span></div>
                    #if(FreePlaces > 0 ){#
                        <div class="footer-item footer-item-places" style=""><span class="event-info-item" style="background-color: rgb(48,214,100);" ><span>Мест: </span> #= FreePlaces#</strong><span class="k-icon  k-i-user" style="font-size: 14px; margin-bottom: 3px; padding-left: 5px;"></span></span></div>
                    #} else {#
                        <div class="footer-item footer-item-places" ><span class="event-info-item" style="background-color: rgb(255,48,100);" ><span>Мест нет</span></span></div>
                    #}#
         </div>
        <div class="k-card-actions k-actions-vertical k-actions-center">
             <span class="k-card-action">
                      <a class="action-order" target="_blank"  href="@Url.Action("Index","Order")?title=#=title#&start=#: kendo.toString(start, 'dd.MM.yyyy HH:mm' )#"> <span class="k-button k-flat k-primary" ><span class="k-icon k-i-cart"></span>Купить билет</span></a>
              </span>
        </div>
       </div>
        @*<hr class="k-card-separator k-separator-vertical">*@

    </div>
</script>
<script>


    $(document).ready(function () {

        if (!kendo.support.mobileOS) {

            $(window).resize();
        }
        else {
            $(".k-scheduler-content").height(520);
            
        }
    });


    function fitWidget(height) {
        var widget = $("#scheduler").data("kendoScheduler");
        $(".k-pane-wrapper").height(height);
        $(".k-scheduler-content").height(650);
        console.log(widget.element.context);
        //height = (height * 80) / 100;
        //console.log(height);
        //size widget to take the whole view
        widget.element.context.css('height','700px');
        //widget.element.closest(".k-widget").height(height);

        widget.resize(true);
    }



    function schedulerFiltering() {

        var scheduler = $("#scheduler").data("kendoScheduler");
        var query = { logic: "and", filters: [] };;

        var dropdownlist_names = $("#filterEventNames").data("kendoDropDownList");
        var ename = dropdownlist_names.value();
        var persons = $("#filterPersons").data("kendoDropDownList").value();

        if (ename) {

            query.filters.push({ field: "title", operator: "eq", value: ename });

            var selected = dropdownlist_names.dataItem();
            var start = kendo.parseDate(selected.Dates[0].Times[0].Start);
            scheduler.date(start);
        }
        if (persons != "0") {

            var arr = persons.split("—");
            if (arr[0]) {
                var min = kendo.parseInt(arr[0]);
                query.filters.push({ field: "FreePlaces", operator: "gte", value: min });
            }
            if (arr[1]) {
                var max = kendo.parseInt(arr[1]);
                query.filters.push({ field: "FreePlaces", operator: "lte", value: max });
            }
        }



        


        scheduler.dataSource.filter(query);


    }


    function setSchedulerHeight(height) {
        var widget = $("#scheduler").data("kendoScheduler");
        widget.element.height(height);
        $(".k-scheduler-content").height(height - 80);
        console.log('ed');
        widget.resize(true);
    }

    $(window).resize(function () {

        var wheight = $(window).outerHeight();
        var mMHeight = $("#mainMenu").height();
        var fHeight = $("#filter-searcher").height();
        var height = wheight - mMHeight - fHeight - 4;
        if (!kendo.support.mobileOS) {
            setSchedulerHeight(height);
        }
        //else {
        //    fitWidget(height);
           
        //}
    });



</script>
